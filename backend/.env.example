# Neon Postgres connection string
# Get this from your Neon project dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/mact_ledger?sslmode=require

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Phase 1: account lockout / brute-force protection
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Phase 1: password policy
PASSWORD_MIN_LENGTH=8

# CORS - frontend origin(s), comma separated
ALLOWED_ORIGINS=http://localhost:3000

# Resend (transactional email for loan approval/rejection notifications)
# Get RESEND_API_KEY from https://resend.com/api-keys
# FROM_EMAIL must be a verified sender on your Resend domain
RESEND_API_KEY=
FROM_EMAIL=MACT Cooperative <loans@yourdomain.com>
