# Neon Postgres connection string
# Get this from your Neon project dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/mact_ledger?sslmode=require

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Phase 1: account lockout / brute-force protection
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Phase 1: password policy
PASSWORD_MIN_LENGTH=8

# CORS - frontend origin(s), comma separated
ALLOWED_ORIGINS=http://localhost:3000

# Resend (transactional email: password recovery, loan and repayment notices)
# RESEND_API_KEY comes from https://resend.com/api-keys. It is backend-only:
# never put it in the frontend environment or browser code.
RESEND_API_KEY=
# A sender on the domain verified in Resend. Either a bare address (the
# cooperative's configured name becomes the display name) or an explicit
# "Display Name <address>" that overrides it.
FROM_EMAIL=notifications@mail.yourdomain.example

# Vercel Blob (cooperative logo upload from Settings)
# Create a Blob store in the Vercel project and copy its read/write token.
# Leave blank to keep logo upload disabled; name/monogram still work.
BLOB_READ_WRITE_TOKEN=
